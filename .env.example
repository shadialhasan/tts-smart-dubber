# TTS Smart Dubber Configuration
# ---------------------------------------------
# System FFmpeg executable path
FFMPEG_BINARY=ffmpeg

# Default audio output parameters
DUBBER_AUDIO_CODEC=aac
DUBBER_AUDIO_BITRATE=192k

# Working directory for audio extraction & temporary files
DUBBER_TEMP_DIR=_dub_temp

# Synchronization tolerance in seconds for audio drift validation
SYNC_TOLERANCE_SECONDS=1.5
